<FindBugsFilter>

    <Match>
        <Bug pattern="CRLF_INJECTION_LOGS" />
    </Match>

    <Match>
        <Class name="org.wso2.carbon.identity.openid4vc.presentation.verification.dto.CredentialVerificationContext"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="org.wso2.carbon.identity.openid4vc.presentation.verification.dto.PresentationMetadata"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="org.wso2.carbon.identity.openid4vc.presentation.verification.dto.PresentationMetadata$Builder"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="org.wso2.carbon.identity.openid4vc.presentation.verification.dto.VerificationResult"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="org.wso2.carbon.identity.openid4vc.presentation.verification.dto.VerificationResult$Builder"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="org.wso2.carbon.identity.openid4vc.presentation.authenticator.cache.VPSessionCacheEntry"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="org.wso2.carbon.identity.openid4vc.presentation.authenticator.executor.VPRegistrationExecutor"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="org.wso2.carbon.identity.openid4vc.presentation.authenticator.model.VPFlowSession"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="org.wso2.carbon.identity.openid4vc.presentation.authenticator.model.VPFlowSession$Builder"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="org.wso2.carbon.identity.openid4vc.presentation.authenticator.model.WalletSubmission"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <Match>
        <Bug pattern="MS_EXPOSE_REP"/>
    </Match>

    <Match>
        <Bug pattern="SERVLET_PARAMETER"/>
    </Match>

    <!--
        UNVALIDATED_REDIRECT
        The redirect base URL (WALLET_LOGIN_PAGE) is a compile-time constant. All dynamic
        parameters appended to it are URL-encoded before use. SpotBugs cannot determine that
        the redirect destination is fixed.
    -->
    <Match>
        <Class name="org.wso2.carbon.identity.openid4vc.presentation.authenticator.VPAuthenticator"/>
        <Bug pattern="UNVALIDATED_REDIRECT"/>
    </Match>

</FindBugsFilter>
